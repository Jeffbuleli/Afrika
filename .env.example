# Local SQLite (default)
DATABASE_URL=file:./data/africa-insight.db

# Admin credentials (change before prod)
ADMIN_EMAIL=editor@africainsight.local
ADMIN_PASSWORD=africa-insight-dev
AUTH_SECRET=change-me-to-a-long-random-string

# Storage: local | r2
STORAGE_DRIVER=local

# Cloudflare R2 (prod)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=africa-insight
# R2_PUBLIC_URL=https://media.your-domain.com

# Postgres (prod VPS)
# DATABASE_URL=postgresql://user:pass@localhost:5432/africa_insight

# Resend (Africa Insight account - NOT McBuleli)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_ALLOW_SEND=true

# ── Search engines (Google + Bing) ───────────────────────────────────────────
# Google Search Console → HTML tag → paste content value only
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# Bing Webmaster Tools → HTML tag msvalidate.01 (optional if verified via GSC import)
# BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# IndexNow (Bing / Yandex) — generate key in Bing Webmaster or: openssl rand -hex 16
# Serves https://www.africa-insight.org/{INDEXNOW_KEY}.txt after rebuild/deploy
# INDEXNOW_KEY=your-indexnow-key-here
# INDEXNOW_HOST=www.africa-insight.org
