# Copy to ops/vps/.env on the VPS only (never commit).

NEXT_PUBLIC_APP_URL=https://www.africa-insight.org
DATABASE_URL=file:./data/africa-insight.db
STORAGE_DRIVER=local

ADMIN_EMAIL=editor@africa-insight.org
ADMIN_PASSWORD=change-me-strong-password
AUTH_SECRET=change-me-to-a-long-random-string

# Resend (Africa Insight account only)
RESEND_API_KEY=re_xxxxxxxx
RESEND_ALLOW_SEND=true

# Bing Webmaster API key (Settings → API Access → API Key) + IndexNow (same key OK)
# BING_WEBMASTER_API_KEY=
# INDEXNOW_KEY=
# INDEXNOW_HOST=www.africa-insight.org
# BING_OAUTH_CLIENT_ID=
# BING_OAUTH_CLIENT_SECRET=
# BING_OAUTH_REFRESH_TOKEN=
